<Window x:Class="EndfieldJiggle.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EndfieldJiggle 独立版 0.2.2" Width="760" Height="480"
        MinWidth="620" MinHeight="440" WindowStartupLocation="CenterScreen"
        Background="#F2F4F5" FontFamily="Microsoft YaHei UI" FontSize="13"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#DCE1E4" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="EndfieldJiggle" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="独立版 · 0.2.2" Foreground="#58616B" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="游戏本体" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
            <Grid x:Name="GameControls" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GamePathBox" MinHeight="38" ToolTip="Endfield.exe 的完整路径"/>
                <Button Grid.Column="1" Click="Browse_Click" Style="{StaticResource IconButton}"
                        Margin="8,0,8,0" ToolTip="选择 Endfield.exe">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}"/>
                </Button>
                <Button Grid.Column="2" Click="Discover_Click" Style="{StaticResource IconButton}"
                        Margin="0" ToolTip="查找已安装的游戏">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}"/>
                </Button>
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                <Button x:Name="LaunchButton" Click="Launch_Click" Background="#176B58" Foreground="White"
                        BorderBrush="#176B58" MinWidth="132">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="启动游戏" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Click="Save_Click" ToolTip="保存游戏路径">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="保存"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Click="Cancel_Click" Visibility="Collapsed"
                        ToolTip="取消等待">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="取消等待"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
            <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,22,0,0">
                <TextBlock Text="触摸与换装" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button x:Name="ConfigureButton" Click="Configure_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="打开配置器"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModsButton" Click="Mods_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Mods 文件夹"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Instructions_Click" Style="{StaticResource IconButton}" ToolTip="打开使用说明">
                        <TextBlock Text="&#xE897;" Style="{StaticResource Icon}"/>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE1E4" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="正在检查完整包…" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="#58616B" FontSize="12" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
