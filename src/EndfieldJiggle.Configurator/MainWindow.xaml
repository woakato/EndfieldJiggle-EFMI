<Window x:Class="EndfieldJiggle.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EndfieldJiggle 0.2.3" Width="1120" Height="820"
        MinWidth="880" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#F2F4F5" AllowDrop="True" PreviewKeyDown="Window_PreviewKeyDown"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#176B58"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#176B58"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#DCE1E4" BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EndfieldJiggle" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="EFMI · 0.2.3" Foreground="#58616B" Margin="14,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenWorkspaceButton" Click="ChooseRuntime_Click" ToolTip="选择触摸 Mod、Mods 或 EFMI 目录">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="打开目录"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OpenRuntimeFolder_Click" ToolTip="打开当前 Mod 目录">
                        <TextBlock Text="&#xED25;" Style="{StaticResource Icon}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#7A838C"
                     VerticalAlignment="Top" Margin="0,6,10,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="StatusText" Text="正在读取…" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RuntimePathText" Foreground="#58616B" TextTrimming="CharacterEllipsis"
                           FontSize="12" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
            <CheckBox x:Name="HotReloadCheck" Grid.Column="2" Content="F10 重载模式" IsChecked="True"
                      Margin="16,0,0,0" VerticalAlignment="Center"
                      ToolTip="保存设置或换装 INI 后，回到游戏松开所有修饰键，再按 F10。首次安装或升级仍需退出游戏。"/>
        </Grid>
        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="22,0" Background="White">
            <TabItem x:Name="LibraryTab" Header="Mod 库">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前 Mods" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="LibrarySummaryText" Text="尚未选择 EFMI" Foreground="#58616B" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RuntimeKeysText" Foreground="#176B58" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="RefreshLibrary_Click" ToolTip="刷新 Mod 库">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LibrarySearchBox" TextChanged="LibraryFilter_Changed" ToolTip="搜索 Mod 名称或目录"/>
                        <CheckBox x:Name="ShowDisabledCheck" Grid.Column="1" Content="显示已停用" Margin="16,0"
                                  VerticalAlignment="Center" Checked="LibraryFilter_Changed" Unchecked="LibraryFilter_Changed"/>
                        <Button Grid.Column="2" Click="ChooseOutfit_Click" Content="打开换装"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="LibraryList" MouseDoubleClick="Library_Open" SelectionChanged="Library_SelectionChanged"
                                  HorizontalContentAlignment="Stretch" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6" MinHeight="70">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#EEF2F3" Width="66" Height="66">
                                            <Grid>
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="#7A838C"/>
                                                <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Directory}" Foreground="#58616B" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                       ToolTip="{Binding Directory}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#176B58" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="LibraryEmptyText" Text="未找到 Mod" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#58616B"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="TouchTab" Header="触摸与参数">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="StartupEnabledCheck" Content="启动时开启触摸" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="ImportProfile_Click" ToolTip="导入参数配置">
                                    <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="ExportProfile_Click" ToolTip="导出参数配置">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="快捷键" Style="{StaticResource Heading}"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="开关触摸" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ToggleKeyCombo" Grid.Column="1" Margin="0,4,12,4"/>
                                <CheckBox x:Name="ToggleCtrlCheck" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ToggleShiftCheck" Grid.Column="3" Content="Shift" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ToggleAltCheck" Grid.Column="4" Content="Alt" VerticalAlignment="Center"/>
                                <Button Grid.Column="5" Style="{StaticResource IconButton}" Tag="toggle" Click="RecordBinding_Click" ToolTip="录入开关组合键">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}"/>
                                </Button>
                                <TextBlock Grid.Row="1" Text="强制关闭" VerticalAlignment="Center"/>
                                <ComboBox x:Name="StopKeyCombo" Grid.Row="1" Grid.Column="1" Margin="0,4,12,4"/>
                                <CheckBox x:Name="StopCtrlCheck" Grid.Row="1" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"/>
                                <CheckBox x:Name="StopShiftCheck" Grid.Row="1" Grid.Column="3" Content="Shift" VerticalAlignment="Center"/>
                                <CheckBox x:Name="StopAltCheck" Grid.Row="1" Grid.Column="4" Content="Alt" VerticalAlignment="Center"/>
                                <Button Grid.Row="1" Grid.Column="5" Style="{StaticResource IconButton}" Tag="stop" Click="RecordBinding_Click" ToolTip="录入关闭组合键">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}"/>
                                </Button>
                                <TextBlock Grid.Row="2" Text="按住拖动" VerticalAlignment="Center"/>
                                <ComboBox x:Name="DragKeyCombo" Grid.Row="2" Grid.Column="1" Margin="0,4,12,4"/>
                                <CheckBox x:Name="DragCtrlCheck" Grid.Row="2" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DragShiftCheck" Grid.Row="2" Grid.Column="3" Content="Shift" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DragAltCheck" Grid.Row="2" Grid.Column="4" Content="Alt" VerticalAlignment="Center"/>
                                <Button Grid.Row="2" Grid.Column="5" Style="{StaticResource IconButton}" Tag="drag" Click="RecordBinding_Click" ToolTip="录入拖动键；鼠标键请从列表选择">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}"/>
                                </Button>
                                <TextBlock Grid.Row="3" Text="诊断信息" VerticalAlignment="Center"/>
                                <ComboBox x:Name="DiagnosticKeyCombo" Grid.Row="3" Grid.Column="1" Margin="0,4,12,4"/>
                                <CheckBox x:Name="DiagnosticCtrlCheck" Grid.Row="3" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DiagnosticShiftCheck" Grid.Row="3" Grid.Column="3" Content="Shift" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DiagnosticAltCheck" Grid.Row="3" Grid.Column="4" Content="Alt" VerticalAlignment="Center"/>
                                <Button Grid.Row="3" Grid.Column="5" Style="{StaticResource IconButton}" Tag="diagnostic" Click="RecordBinding_Click" ToolTip="录入诊断组合键">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}"/>
                                </Button>
                            </Grid>
                            <Border BorderBrush="#DCE1E4" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="形变参数" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0"/>
                                        <ComboBox x:Name="PhysicsPresetCombo" Grid.Column="1" SelectionChanged="PhysicsPreset_Changed" ToolTip="参数预设">
                                            <ComboBoxItem Content="自定义" IsSelected="True"/>
                                            <ComboBoxItem Content="轻柔"/>
                                            <ComboBoxItem Content="标准"/>
                                            <ComboBoxItem Content="明显"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="42"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="影响半径" VerticalAlignment="Center"/>
                                        <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0.01" Maximum="0.5"
                                                TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RadiusValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Text="最大位移" VerticalAlignment="Center"/>
                                        <Slider x:Name="MaxOffsetSlider" Grid.Row="1" Grid.Column="1" Minimum="0.001" Maximum="0.15"
                                                TickFrequency="0.001" IsSnapToTickEnabled="True" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MaxOffsetValueText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Text="拖动比例" VerticalAlignment="Center"/>
                                        <Slider x:Name="DragScaleSlider" Grid.Row="2" Grid.Column="1" Minimum="0.01" Maximum="3"
                                                TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DragScaleValueText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="1" Margin="0,16,0,0">
                        <Button Style="{StaticResource IconButton}" Click="Reload_Click" ToolTip="重新读取已保存参数">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button Content="默认值" Click="Defaults_Click"/>
                        <Button Content="无 Shift 拖动" Click="NoShiftDrag_Click" ToolTip="仅修改待保存的拖动绑定为鼠标左键，不修改其它 Mod 的键位"/>
                        <Button x:Name="RestoreButton" Content="撤销上次保存" Click="Restore_Click" IsEnabled="False"/>
                        <Button x:Name="ApplyButton" Content="保存配置" Click="Apply_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="OutfitTab" Header="换装适配">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="86" Height="86" Background="#EEF2F3">
                            <Grid>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="#7A838C"/>
                                <Image x:Name="OutfitPreviewImage" Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="OutfitNameText" Text="未选择换装" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="OutfitPathBox" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="ChooseOutfit_Click" Content="选择换装" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="0,14,0,10">
                        <Button x:Name="InspectOutfitButton" Style="{StaticResource IconButton}" Click="InspectOutfit_Click" IsEnabled="False" ToolTip="重新分析换装">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button x:Name="AdaptOutfitButton" Content="适配所选绘制" Click="AdaptOutfit_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="RestoreOutfitButton" Content="恢复原换装" Click="RestoreOutfit_Click" IsEnabled="False"/>
                        <Button Style="{StaticResource IconButton}" Click="OpenOutfitFolder_Click" ToolTip="打开换装目录">
                            <TextBlock Text="&#xED25;" Style="{StaticResource Icon}"/>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="OutfitSummaryText" Grid.Row="2" Text="尚未分析" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DrawSearchBox" TextChanged="DrawFilter_Changed" ToolTip="搜索文件、绘制段或分支"/>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="SelectAllDraws_Click" ToolTip="选中全部受支持绘制" Margin="10,0,8,0">
                                <TextBlock Text="&#xE8B3;" Style="{StaticResource Icon}"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="SelectNoDraws_Click" ToolTip="取消全部选择">
                                <TextBlock Text="&#xE894;" Style="{StaticResource Icon}"/>
                            </Button>
                        </Grid>
                        <DataGrid x:Name="DrawGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0" BorderBrush="#DCE1E4" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="触摸" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding Selectable}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="绘制段" Binding="{Binding Section}" Width="2*" MinWidth="160" IsReadOnly="True"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="2*" MinWidth="160" IsReadOnly="True"/>
                                <DataGridTextColumn Header="索引数" Binding="{Binding Count}" Width="78" IsReadOnly="True"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="1.4*" MinWidth="150" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Expander Grid.Row="2" Header="依赖与分析明细" Margin="0,10,0,0">
                            <TextBox x:Name="OutfitDetailsText" Height="150" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#F7F8F9" Padding="10"/>
                        </Expander>
                    </Grid>
                    <WrapPanel Grid.Row="4" Margin="0,14,0,0">
                        <Button x:Name="CheckStateButton" Content="检查 QAQM 状态（可选）" Click="CheckState_Click" IsEnabled="False"
                                ToolTip="仅检查当前 EFMI/Mods 中实际加载的换装；不会阻止普通绘制适配。"/>
                        <Button x:Name="RecoverStateButton" Content="修复 QAQM 状态（可选）" Click="RecoverState_Click" IsEnabled="False"
                                ToolTip="仅在主动检查后，依据当前换装已有证据恢复缺失状态声明。"/>
                        <Button x:Name="RestoreStateButton" Content="撤销状态恢复" Click="RestoreState_Click" IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="DiagnosticsTab" Header="按键与诊断">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="重载配置" Style="{StaticResource Heading}"/>
                    <TextBlock x:Name="ReloadBindingText" Grid.Row="1" Text="尚未读取 EFMI 的重载绑定" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <DockPanel Grid.Row="2" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CheckConflicts_Click" ToolTip="扫描潜在按键冲突">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        </Button>
                        <TextBlock Text="潜在按键冲突" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="ConflictDetailsText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#F7F8F9" Padding="12"/>
                    <Button Grid.Row="4" Content="导出诊断报告" HorizontalAlignment="Left" Click="ExportDiagnostics_Click" Margin="0,14,0,0"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="InstallationTab" Header="安装与恢复">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="EFMI 安装位置" Style="{StaticResource Heading}"/>
                    <DockPanel Grid.Row="1">
                        <Button DockPanel.Dock="Right" Content="选择目录" Click="ChooseEfmi_Click" Margin="12,0,0,0"/>
                        <TextBox x:Name="EfmiPathBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock x:Name="InstallPreviewText" Text="尚未选择安装目录" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button x:Name="InstallButton" Content="安装 / 升级" Click="Install_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
                            <Button x:Name="InstallRestoreButton" Content="恢复安装前版本" Click="InstallRestore_Click" IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBox x:Name="InstallResultText" Grid.Row="3" Margin="0,18,0,0"
                             IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Margin="22,12">
            <Grid x:Name="BusyStrip" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BusyText" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" Margin="8,0,16,0"/>
                <Button x:Name="CancelOperationButton" Grid.Column="2" Style="{StaticResource IconButton}"
                        Click="CancelOperation_Click" ToolTip="取消当前扫描">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}"/>
                </Button>
            </Grid>
            <TextBlock x:Name="FooterText" Foreground="#58616B" TextWrapping="Wrap" Text="0.2.3"/>
        </StackPanel>
    </Grid>
</Window>
