<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>EndfieldJiggleConfigurator</AssemblyName>
    <Version>0.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EndfieldJiggle.Configurator.Core\EndfieldJiggle.Configurator.Core.csproj"/>
  </ItemGroup>
  <ItemGroup Condition="'$(InstallableResourceDirectory)' != ''">
    <EmbeddedResource Include="$(InstallableResourceDirectory)\InstallableRuntime.zip"
                      LogicalName="EndfieldJiggle.InstallableRuntime.zip"/>
    <EmbeddedResource Include="$(InstallableResourceDirectory)\DOTNET-LICENSE.txt"
                      LogicalName="EndfieldJiggle.Notices.DOTNET-LICENSE.txt"/>
    <EmbeddedResource Include="$(InstallableResourceDirectory)\DOTNET-THIRD-PARTY-NOTICES.txt"
                      LogicalName="EndfieldJiggle.Notices.DOTNET-THIRD-PARTY-NOTICES.txt"/>
    <EmbeddedResource Include="$(InstallableResourceDirectory)\LICENSE"
                      LogicalName="EndfieldJiggle.Notices.LICENSE"/>
    <EmbeddedResource Include="$(InstallableResourceDirectory)\INSTALL-zh-CN.md"
                      LogicalName="EndfieldJiggle.Notices.INSTALL-zh-CN.md"/>
    <EmbeddedResource Include="$(InstallableResourceDirectory)\DISCLAIMER.md"
                      LogicalName="EndfieldJiggle.Notices.DISCLAIMER.md"/>
  </ItemGroup>
</Project>
