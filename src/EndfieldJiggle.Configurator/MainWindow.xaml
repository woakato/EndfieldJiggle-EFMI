<Window x:Class="EndfieldJiggle.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EndfieldJiggle 配置器" Width="820" Height="720"
        MinWidth="720" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#F4F5F6" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="选择 Mod 文件夹" Click="ChooseRuntime_Click"/>
            <StackPanel>
                <TextBlock Text="EndfieldJiggle" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="配置保存在已安装的 Mods 运行时中。关闭此程序后仍按保存值运行。"
                           Margin="0,4,0,0" Foreground="#58616B" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9DDE1" BorderThickness="1"
                Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#7A838C"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText" Text="查找已安装的运行时…" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="RuntimePathText" Foreground="#58616B" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="触摸开关" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="StartupEnabledCheck" Content="游戏启动后默认开启触摸"/>
                        <TextBlock Text="关闭此选项时，可在游戏内使用“开关触摸”键临时启用。"
                                   Margin="22,2,0,0" Foreground="#58616B" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="按键" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="开关触摸" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox x:Name="ToggleKeyCombo" Grid.Column="1" Margin="0,3"/>
                        <CheckBox x:Name="ToggleCtrlCheck" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center" Margin="12,3"/>
                        <CheckBox x:Name="ToggleShiftCheck" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="8,3"/>
                        <CheckBox x:Name="ToggleAltCheck" Grid.Column="4" Content="Alt" VerticalAlignment="Center" Margin="8,3"/>

                        <TextBlock Grid.Row="1" Text="强制关闭" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox x:Name="StopKeyCombo" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                        <CheckBox x:Name="StopCtrlCheck" Grid.Row="1" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center" Margin="12,3"/>
                        <CheckBox x:Name="StopShiftCheck" Grid.Row="1" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="8,3"/>
                        <CheckBox x:Name="StopAltCheck" Grid.Row="1" Grid.Column="4" Content="Alt" VerticalAlignment="Center" Margin="8,3"/>

                        <TextBlock Grid.Row="2" Text="按住拖动" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox x:Name="DragKeyCombo" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                        <CheckBox x:Name="DragCtrlCheck" Grid.Row="2" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center" Margin="12,3"/>
                        <CheckBox x:Name="DragShiftCheck" Grid.Row="2" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="8,3"/>
                        <CheckBox x:Name="DragAltCheck" Grid.Row="2" Grid.Column="4" Content="Alt" VerticalAlignment="Center" Margin="8,3"/>

                        <TextBlock Grid.Row="3" Text="诊断信息" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox x:Name="DiagnosticKeyCombo" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                        <CheckBox x:Name="DiagnosticCtrlCheck" Grid.Row="3" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center" Margin="12,3"/>
                        <CheckBox x:Name="DiagnosticShiftCheck" Grid.Row="3" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="8,3"/>
                        <CheckBox x:Name="DiagnosticAltCheck" Grid.Row="3" Grid.Column="4" Content="Alt" VerticalAlignment="Center" Margin="8,3"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="形变强度" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="影响半径" VerticalAlignment="Center" Margin="0,5"/>
                        <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0.01" Maximum="0.5"
                                TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="8,3"/>
                        <TextBlock x:Name="RadiusValueText" Grid.Column="2" Text="0.12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Text="最大位移" VerticalAlignment="Center" Margin="0,5"/>
                        <Slider x:Name="MaxOffsetSlider" Grid.Row="1" Grid.Column="1"
                                Minimum="0.001" Maximum="0.15" TickFrequency="0.001"
                                IsSnapToTickEnabled="True" Margin="8,3"/>
                        <TextBlock x:Name="MaxOffsetValueText" Grid.Row="1" Grid.Column="2"
                                   Text="0.04" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Text="拖动比例" VerticalAlignment="Center" Margin="0,5"/>
                        <Slider x:Name="DragScaleSlider" Grid.Row="2" Grid.Column="1"
                                Minimum="0.01" Maximum="3" TickFrequency="0.01"
                                IsSnapToTickEnabled="True" Margin="8,3"/>
                        <TextBlock x:Name="DragScaleValueText" Grid.Row="2" Grid.Column="2"
                                   Text="0.75" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#FFF7E6" BorderBrush="#E6C779" BorderThickness="1"
                Padding="10" Margin="0,12,0,10">
            <TextBlock Text="应用前请退出游戏和 XXMI。只会更新本 Mod 的运行参数文件，不会修改游戏本体或注入器。"
                       TextWrapping="Wrap"/>
        </Border>
        <DockPanel Grid.Row="4" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="重新读取" Click="Reload_Click"/>
                <Button Content="恢复此版本默认" Click="Defaults_Click"/>
                <Button x:Name="RestoreButton" Content="恢复上次设置" Click="Restore_Click" IsEnabled="False"/>
                <Button x:Name="ApplyButton" Content="应用设置" Click="Apply_Click"
                        IsEnabled="False" Background="#176B58" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="#58616B"/>
        </DockPanel>
    </Grid>
</Window>
