<Window x:Class="EndfieldJiggle.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EndfieldJiggle 0.2.1" Width="1000" Height="790"
        MinWidth="780" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="#F4F5F6" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="选择已安装 Mod" Click="ChooseRuntime_Click"/>
            <TextBlock Text="EndfieldJiggle" FontSize="25" FontWeight="SemiBold"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#7A838C"
                     VerticalAlignment="Top" Margin="0,6,10,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="StatusText" Text="正在读取…" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RuntimePathText" Foreground="#58616B" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Grid>
        <TabControl x:Name="MainTabs" Grid.Row="2">
            <TabItem x:Name="InstallationTab" Header="安装">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="EFMI 安装位置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DockPanel Grid.Row="1">
                        <Button DockPanel.Dock="Right" Content="选择 EFMI 目录" Click="ChooseEfmi_Click" Margin="12,0,0,0"/>
                        <TextBox x:Name="EfmiPathBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock x:Name="InstallPreviewText" Text="尚未选择安装目录" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallButton" Content="安装 / 升级" Click="Install_Click"
                                    IsEnabled="False" Background="#176B58" Foreground="White"/>
                            <Button x:Name="InstallRestoreButton" Content="恢复安装前版本" Click="InstallRestore_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBox x:Name="InstallResultText" Grid.Row="3" Margin="0,18,0,0"
                             IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="TouchTab" Header="触摸配置">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <CheckBox x:Name="StartupEnabledCheck" Content="游戏启动后默认开启触摸" Margin="0,0,0,18"/>
                            <TextBlock Text="按键" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="开关触摸" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ToggleKeyCombo" Grid.Column="1" Margin="0,3"/>
                                <CheckBox x:Name="ToggleCtrlCheck" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center" Margin="12,3"/>
                                <CheckBox x:Name="ToggleShiftCheck" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="8,3"/>
                                <CheckBox x:Name="ToggleAltCheck" Grid.Column="4" Content="Alt" VerticalAlignment="Center" Margin="8,3"/>
                                <TextBlock Grid.Row="1" Text="强制关闭" VerticalAlignment="Center"/>
                                <ComboBox x:Name="StopKeyCombo" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                <CheckBox x:Name="StopCtrlCheck" Grid.Row="1" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center" Margin="12,3"/>
                                <CheckBox x:Name="StopShiftCheck" Grid.Row="1" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="8,3"/>
                                <CheckBox x:Name="StopAltCheck" Grid.Row="1" Grid.Column="4" Content="Alt" VerticalAlignment="Center" Margin="8,3"/>
                                <TextBlock Grid.Row="2" Text="按住拖动" VerticalAlignment="Center"/>
                                <ComboBox x:Name="DragKeyCombo" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                                <CheckBox x:Name="DragCtrlCheck" Grid.Row="2" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center" Margin="12,3"/>
                                <CheckBox x:Name="DragShiftCheck" Grid.Row="2" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="8,3"/>
                                <CheckBox x:Name="DragAltCheck" Grid.Row="2" Grid.Column="4" Content="Alt" VerticalAlignment="Center" Margin="8,3"/>
                                <TextBlock Grid.Row="3" Text="诊断信息" VerticalAlignment="Center"/>
                                <ComboBox x:Name="DiagnosticKeyCombo" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                                <CheckBox x:Name="DiagnosticCtrlCheck" Grid.Row="3" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center" Margin="12,3"/>
                                <CheckBox x:Name="DiagnosticShiftCheck" Grid.Row="3" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="8,3"/>
                                <CheckBox x:Name="DiagnosticAltCheck" Grid.Row="3" Grid.Column="4" Content="Alt" VerticalAlignment="Center" Margin="8,3"/>
                            </Grid>
                            <TextBlock Text="形变强度" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="影响半径" VerticalAlignment="Center" Margin="0,5"/>
                                <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0.01" Maximum="0.5"
                                        TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="8,3"/>
                                <TextBlock x:Name="RadiusValueText" Grid.Column="2" Text="0.12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="最大位移" VerticalAlignment="Center" Margin="0,5"/>
                                <Slider x:Name="MaxOffsetSlider" Grid.Row="1" Grid.Column="1" Minimum="0.001" Maximum="0.15"
                                        TickFrequency="0.001" IsSnapToTickEnabled="True" Margin="8,3"/>
                                <TextBlock x:Name="MaxOffsetValueText" Grid.Row="1" Grid.Column="2" Text="0.04" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2" Text="拖动比例" VerticalAlignment="Center" Margin="0,5"/>
                                <Slider x:Name="DragScaleSlider" Grid.Row="2" Grid.Column="1" Minimum="0.01" Maximum="3"
                                        TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="8,3"/>
                                <TextBlock x:Name="DragScaleValueText" Grid.Row="2" Grid.Column="2" Text="0.75" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                        <Button Content="重新读取" Click="Reload_Click"/>
                        <Button Content="恢复默认值" Click="Defaults_Click"/>
                        <Button x:Name="RestoreButton" Content="恢复上次设置" Click="Restore_Click" IsEnabled="False"/>
                        <Button x:Name="ApplyButton" Content="保存配置" Click="Apply_Click"
                                IsEnabled="False" Background="#176B58" Foreground="White"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="OutfitTab" Header="换装适配">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="选择换装目录" Click="ChooseOutfit_Click" Margin="12,0,0,0"/>
                        <TextBox x:Name="OutfitPathBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,14,0,10">
                        <Button x:Name="InspectOutfitButton" Content="分析" Click="InspectOutfit_Click" IsEnabled="False"/>
                        <Button x:Name="AdaptOutfitButton" Content="原目录适配" Click="AdaptOutfit_Click" IsEnabled="False"
                                Background="#176B58" Foreground="White"/>
                        <Button x:Name="RestoreOutfitButton" Content="恢复原换装" Click="RestoreOutfit_Click" IsEnabled="False"/>
                        <CheckBox x:Name="HotReloadCheck" Content="游戏内重载模式（F10）" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="OutfitSummaryText" Grid.Row="2" Text="尚未分析" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox x:Name="OutfitDetailsText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="White" Padding="10"/>
                    <WrapPanel Grid.Row="4" Margin="0,14,0,0">
                        <Button x:Name="CheckStateButton" Content="检查 QAQM 状态" Click="CheckState_Click" IsEnabled="False"/>
                        <Button x:Name="RecoverStateButton" Content="补齐缺失状态" Click="RecoverState_Click" IsEnabled="False"/>
                        <Button x:Name="RestoreStateButton" Content="撤销状态恢复" Click="RestoreState_Click" IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="FooterText" Grid.Row="3" Margin="0,12,0,0" Foreground="#58616B"
                   TextWrapping="Wrap" Text="0.2.1"/>
    </Grid>
</Window>
